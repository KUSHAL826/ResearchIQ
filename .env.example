# Google Gemini API Key (required for AI synthesis, embeddings, and LangGraph orchestration)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# Gemini model configuration
RESEARCHIQ_LLM_MODEL=gemini-2.5-flash
RESEARCHIQ_EMBEDDING_MODEL=text-embedding-004

# Optional polite pool email for OpenAlex API (improves rate limits)
OPENALEX_MAILTO=

# Optional Semantic Scholar API key (higher rate limits; public API also works without key)
SEMANTIC_SCHOLAR_API_KEY=
